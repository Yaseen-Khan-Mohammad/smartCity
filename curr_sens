WebServer server(80);


// =====================================================
// ACS712 SETTINGS
// =====================================================

const int currentPin = 32;

// ACS712 30A sensitivity
// 66 mV per Ampere
const float sensitivity = 0.066;

// Actual zero-current voltage
float zeroVoltage = 2.5;


// =====================================================
// READ SENSOR VOLTAGE
// =====================================================

float readSensorVoltage()
{
  long total = 0;

  const int samples = 1000;

  for (int i = 0; i < samples; i++)
  {
    total += analogRead(currentPin);
  }

  float averageADC = total / (float)samples;

  float voltage = averageADC * 3.3 / 4095.0;

  return voltage;
}


// =====================================================
// CALIBRATE ZERO CURRENT
// =====================================================

void calibrateSensor()
{
  Serial.println();
  Serial.println("================================");
  Serial.println("ACS712 CALIBRATION");
  Serial.println("================================");

  Serial.println("Make sure NO CURRENT is flowing.");
  Serial.println("Calibration starting in 3 seconds...");

  delay(3000);

  long total = 0;

  const int samples = 3000;

  for (int i = 0; i < samples; i++)
  {
    total += analogRead(currentPin);
    delayMicroseconds(100);
  }

  float averageADC = total / (float)samples;

  zeroVoltage = averageADC * 3.3 / 4095.0;

  Serial.print("Average ADC = ");
  Serial.println(averageADC);

  Serial.print("Zero Voltage = ");
  Serial.print(zeroVoltage, 4);
  Serial.println(" V");

  Serial.println("Calibration complete!");
  Serial.println("================================");
  Serial.println();
}


// =====================================================
// READ CURRENT
// =====================================================

float readCurrent()
{
  float sensorVoltage = readSensorVoltage();

  float current =
    (sensorVoltage - zeroVoltage) / sensitivity;

  // Remove small noise
  if (abs(current) < 0.10)
  {
    current = 0;
  }

  return current;
}


