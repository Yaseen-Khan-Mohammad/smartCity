#include <WiFi.h>
#include <WebServer.h>

// ================= WIFI =================
const char* ssid = "YOUR_WIFI_NAME";
const char* password = "YOUR_WIFI_PASSWORD";

WebServer server(80);

// ================= CURRENT SENSOR =================
const int currentPin = 32;

// For ACS712 20A
const float sensitivity = 0.100;

// Change this after calibration
float zeroVoltage = 2.5;


// ================= READ CURRENT =================
float readCurrent()
{
  long sum = 0;

  // Take many samples to reduce noise
  for (int i = 0; i < 2000; i++)
  {
    sum += analogRead(currentPin);
  }

  float adcValue = sum / 2000.0;

  float voltage = adcValue * 3.3 / 4095.0;

  float current = (voltage - zeroVoltage) / sensitivity;

  // Remove small noise
  if (abs(current) < 0.10)
  {
    current = 0;
  }

  return current;
}


